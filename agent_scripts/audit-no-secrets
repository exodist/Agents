#!/usr/bin/env perl
use strict;
use warnings;

# Scan a tree for credentials and other material that must never be committed.
#
# Mandatory before every commit to ~/projects/Agents (see REPO_RULES.md "No
# credentials, no secrets, ever"). Useful anywhere else too.
#
# Checks:
#   - key material (PEM/OpenSSH/PGP block headers)
#   - credential-shaped assignments (password=..., api_key: ..., Bearer ...)
#   - DSNs and URLs carrying an inline password
#   - high-entropy blobs that look like tokens
#   - filenames that are credential stores (.env, .netrc, id_rsa, *.pem, ...)
#   - non-text files, which cannot be reviewed by eye
#
# A placeholder is not a finding: <API_KEY>, REDACTED, CHANGEME, xxx, ...,
# YOUR_TOKEN_HERE and friends are recognised and skipped. So is any line
# carrying the literal token `not-a-secret`.
#
# Usage:
#   perl agent_scripts/audit-no-secrets            # scan .
#   perl agent_scripts/audit-no-secrets /some/path
#   perl agent_scripts/audit-no-secrets --staged   # only git-staged files
#
# Exits 1 on any finding, 0 on clean. Heuristic in both directions: it will
# miss a cleverly shaped secret, and it cannot judge intent. Read the diff too.

use File::Find ();
use Getopt::Long qw/GetOptions/;

my $staged = 0;
GetOptions('staged' => \$staged) or die "bad arguments\n";

my @ROOTS = @ARGV ? @ARGV : ('.');

my @KEY_MATERIAL = (
    qr/-----BEGIN [A-Z ]*PRIVATE KEY-----/,
    qr/-----BEGIN OPENSSH PRIVATE KEY-----/,
    qr/-----BEGIN PGP PRIVATE KEY BLOCK-----/,
    qr/\bssh-rsa\s+AAAA[0-9A-Za-z+\/]{60,}/,
    qr/\bPuTTY-User-Key-File-\d/,
);

my @CREDENTIAL_SHAPES = (
    qr/\b(?:pass(?:wd|word|phrase)|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret|auth[_-]?token|private[_-]?key)\b\s*[:=]\s*\S+/i,
    qr/\bAuthorization\s*:\s*(?:Bearer|Basic)\s+\S+/i,
    qr/\b(?:AKIA|ASIA)[0-9A-Z]{16}\b/,        # AWS access key id
    qr/\bgh[pousr]_[0-9A-Za-z]{30,}\b/,       # GitHub token
    qr/\bxox[abposr]-[0-9A-Za-z-]{10,}\b/,    # Slack token
    qr/\bsk-[0-9A-Za-z]{20,}\b/,              # OpenAI-style key
    qr{://[^/\s:@]+:[^/\s@]+@},               # user:password@host in a URL
    qr/\bdbi:[^;\s]+;[^\s]*\bpassword=(?!<|\$)\S+/i,
);

# Anything matching is a placeholder, not a leak.
my $PLACEHOLDER = qr/
    ^(?:
        <[^>]*>            | \$\{?\w+\}?      | %\w+%             |
        ["']?(?:
            x{3,}          | \.{3,}           | \*{3,}            |
            redacted       | changeme         | change_me         |
            placeholder    | example          | secret            |
            password       | your[_-]?\w+     | my[_-]?\w+        |
            some[_-]?\w+   | fake\w*          | dummy\w*          |
            test\w*        | none             | null              | undef
        )["']?
    )$
/xi;

my @CREDENTIAL_FILES = (
    qr/^\.env(?:\..*)?$/,      qr/^\.netrc$/,     qr/^\.pgpass$/,
    qr/^\.my\.cnf$/,           qr/^id_[a-z]+$/,   qr/^id_[a-z]+\.pub$/,
    qr/^\.credentials\.json$/, qr/^credentials$/, qr/^auth\.json$/,
    qr/\.(?:pem|p12|pfx|jks|keystore|ppk)$/i, qr/^\.htpasswd$/,
);

my @findings;

for my $file (collect_files()) {
    my ($base) = $file =~ m{([^/]+)\z};

    # This script has to spell out the patterns it hunts for, so it matches
    # itself on every run.
    next if $base eq 'audit-no-secrets';

    if (grep { $base =~ $_ } @CREDENTIAL_FILES) {
        push @findings => "$file: credential-store filename";
        next;
    }

    next unless -f $file && -s $file;

    if (-B $file) {
        push @findings => "$file: non-text file (cannot be reviewed by eye)";
        next;
    }

    scan_file($file);
}

if (@findings) {
    print "Possible secrets (credentials are forbidden in this public repository):\n";
    print "  $_\n" for @findings;
    print "\nIf a hit is a real credential: ROTATE IT FIRST, then tell the owner.\n";
    print "If it is an example, use an obvious placeholder (<API_KEY>, REDACTED).\n";
    print "If it is a genuine false positive, add 'not-a-secret' to that line.\n";
    exit 1;
}

print "OK: no credentials or sensitive material found.\n";
exit 0;

# {{{ Collection

sub collect_files {
    if ($staged) {
        my @out = `git diff --cached --name-only --diff-filter=ACM`;
        chomp @out;
        return grep { -f $_ } @out;
    }

    my @out;
    for my $root (@ROOTS) {
        if (-f $root) {
            push @out => $root;
            next;
        }
        die "'$root' is not a file or directory\n" unless -d $root;

        File::Find::find(
            {
                no_chdir => 1,
                wanted   => sub {
                    if (-d $_ && m{(?:^|/)(?:\.git|blib|node_modules|_build|cover_db)$}) {
                        $File::Find::prune = 1;
                        return;
                    }
                    push @out => $_ if -f $_;
                },
            },
            $root,
        );
    }

    return sort @out;
}

# }}} Collection

# {{{ Scanning

sub scan_file {
    my ($path) = @_;

    open(my $fh, '<', $path) or return;

    my $line_no = 0;
    while (my $line = <$fh>) {
        $line_no++;
        chomp $line;
        next if $line =~ /not-a-secret/;

        for my $re (@KEY_MATERIAL) {
            next unless $line =~ $re;
            push @findings => sprintf('%s:%d: key material', $path, $line_no);
            return;
        }

        for my $re (@CREDENTIAL_SHAPES) {
            next unless $line =~ $re;
            next if placeholder_value($line);
            push @findings => sprintf('%s:%d: %s', $path, $line_no, trim($line));
            last;
        }

        push @findings => sprintf('%s:%d: high-entropy blob', $path, $line_no)
            if high_entropy_blob($line);
    }

    return;
}

# True when every value assigned to a credential keyword on this line is an
# obvious stand-in. Only values attached to a keyword are examined -- prose
# around them routinely contains colons that would otherwise be read as
# assignments. A line with no keyword/value pair is never excused here.
sub placeholder_value {
    my ($line) = @_;

    my @values = $line =~ /
        \b(?:pass(?:wd|word|phrase)|secret|api[_-]?key|access[_-]?token
          |refresh[_-]?token|client[_-]?secret|auth[_-]?token|private[_-]?key)
        \b \s* [:=] \s* (\S+)
    /gix;

    return 0 unless @values;

    for my $value (@values) {
        $value =~ s/^[`'"(\[]+//;
        $value =~ s/[`'")\],;.]+$//;

        next if $value =~ $PLACEHOLDER;
        next if length($value) < 6;
        return 0;
    }

    return 1;
}

# A long unbroken run of base64/hex with real character variety. Prose,
# checksums in documentation, and indented code do not reach this shape.
sub high_entropy_blob {
    my ($line) = @_;

    return 0 if $line =~ m{https?://};

    # Filesystem paths read as one long mixed-case run once the separators are
    # counted. Drop absolute, tilde-prefixed, and relative path-shaped runs;
    # a real token is not made safer by containing a slash.
    $line =~ s{(?:^|(?<=\s)|(?<=`))(?:~/|/)?[\w.+-]+(?:/[\w.+-]+)+}{ }g;

    for my $candidate ($line =~ /([A-Za-z0-9+\/_-]{32,})/g) {
        next if $candidate =~ /^[0-9]+$/;
        next if $candidate =~ /^[a-f0-9]+$/i && length($candidate) <= 40;    # a git sha
        next unless $candidate =~ /[a-z]/ && $candidate =~ /[A-Z]/ && $candidate =~ /[0-9]/;
        return 1;
    }

    return 0;
}

sub trim {
    my ($str) = @_;
    $str =~ s/^\s+|\s+$//g;
    return length($str) > 120 ? substr($str, 0, 117) . '...' : $str;
}

# }}} Scanning

#!/usr/bin/env perl
use strict;
use warnings;

# Audit a project's optional integration with the shared Agents repository.
# This is deliberately separate from packaging: a project can use Dist::Zilla
# without adopting these files, and can adopt these files without packaging a
# distribution.
#
# Usage:
#   perl agent_scripts/audit-project-wiring /path/to/project
#
# Findings are advisory. Exits 1 when anything is reported, 0 when clean.

use File::Spec ();
use Getopt::Long qw/GetOptions/;

my $quiet = 0;
GetOptions('quiet' => \$quiet) or die "bad arguments\n";

my $root = shift(@ARGV) // '.';
die "'$root' is not a directory\n" unless -d $root;

my @findings;

my %required = (
    'Changes'               => ['WIR001', 'no Changes file'],
    'AGENTS.md'             => ['WIR002', 'no AGENTS.md with project instructions'],
    'AGENTS_OVERRIDE.md'    => ['WIR003', 'no AGENTS_OVERRIDE.md recording project declarations and overrides'],
    '.perltidyrc'           => ['WIR004', 'no .perltidyrc'],
    'AI_AND_LLM_POLICY.txt' => ['WIR005', 'no AI_AND_LLM_POLICY.txt'],
    'TEMPLATE.pod'          => ['WIR006', 'no TEMPLATE.pod'],
);

for my $file (sort keys %required) {
    next if -e File::Spec->catfile($root, $file);
    note(@{$required{$file}});
}

check_agents($root);
check_entry_point($root, 'CLAUDE.md');
check_entry_point($root, 'CODEX.md');

if (@findings) {
    printf("project wiring audit: %s\n\n", File::Spec->rel2abs($root));
    print "  $_\n" for @findings;
    printf("\n%d finding(s).\n", scalar(@findings));
    exit 1;
}

print "OK: optional Agents project wiring is complete.\n" unless $quiet;
exit 0;

sub check_agents {
    my ($project) = @_;
    my $content = read_file(File::Spec->catfile($project, 'AGENTS.md'));
    return unless defined $content;
    note('WIR100', 'AGENTS.md does not point at the shared Agents repository')
        unless $content =~ m{projects/Agents};
    return;
}

sub check_entry_point {
    my ($project, $name) = @_;
    my $content = read_file(File::Spec->catfile($project, $name));
    return unless defined $content;

    note('WIR101', "$name does not direct the agent to AGENTS.md")
        unless $content =~ /AGENTS\.md/;

    my @lines = grep { /\S/ && !/^#/ } split(/\n/, $content);
    note('WIR102', "$name carries project instructions instead of only directing the agent to AGENTS.md")
        if @lines > 8;
    return;
}

sub read_file {
    my ($path) = @_;
    open(my $fh, '<', $path) or return undef;
    local $/;
    return <$fh>;
}

sub note {
    my ($code, $message) = @_;
    push @findings => "[warning $code] $message";
    return;
}

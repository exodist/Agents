#!/usr/bin/env perl
use strict;
use warnings;

# Serialize high-concurrency test runs across every agent and every project
# on this machine, and put a hard wall-clock ceiling on them.
#
# Two agents each running `prove -j16` against database-backed suites fan out
# to well over a hundred servers and OOM the box. This wrapper takes an
# advisory flock on ~/projects/.agent-test-lock for the duration of any run
# above --jobs 4, so only one such run happens at a time.
#
# This is agent-side tooling. Nothing in any project's lib/ or t/ knows about
# it, and it never ships. See TESTING.md, "The shared test lock".
#
# Usage:
#   agent-test-lock [options] -- <command...>
#
#   --jobs N        Concurrency this run will use. Default: parsed from the
#                   command's -jN / -j N / --jobs N / --jobs=N, else 16.
#                   A run at 4 or below skips the lock entirely.
#   --timeout SECS  Kill the command after this long. Defaults to 900 for a
#                   serial run and 300 for a concurrent run. 0 disables.
#   --wait SECS     Give up waiting for the lock after this long. Default 3600.
#   --no-lock       Run without taking the lock.
#   --no-author     Force AUTHOR_TESTING=0 (for checking skip behavior).
#   --lock-file P   Override the lock path (default $AGENT_TEST_LOCK or
#                   ~/projects/.agent-test-lock).
#   --memory-max S  Memory cap for the whole run, as a systemd MemoryMax
#                   value (75%, 48G, ...). Default 75% of RAM.
#   --no-memory-cap Run without the memory cap.
#   --quiet         Do not narrate lock acquisition.
#
# AUTHOR_TESTING=1 is forced unless --no-author is given. The explicit flag
# forces AUTHOR_TESTING=0 for a deliberate check of skip behavior.
#
# The memory cap runs the command in a transient systemd user scope with
# MemoryMax set and swap disabled, so a runaway test is killed on its own
# instead of taking the machine into a global OOM. Where no user systemd is
# reachable (sandboxes, containers) the run goes ahead uncapped with a warning.
#
# Exit status is the command's own. A timeout exits 124, matching timeout(1).
# Failure to acquire the lock within --wait exits 125.

use Fcntl qw/:flock O_RDWR O_CREAT/;
use IO::Handle ();
use POSIX qw/:sys_wait_h strftime/;
use Time::HiRes ();
use Sys::Hostname qw/hostname/;
use Cwd qw/getcwd/;

my $JOB_THRESHOLD = 4;
my $EXIT_TIMEOUT  = 124;
my $EXIT_NO_LOCK  = 125;

my %opt = (
    timeout         => undef,
    wait            => 3600,
    'no-lock'       => 0,
    'no-author'     => 0,
    'no-memory-cap' => 0,
    memory_max      => '75%',
    quiet           => 0,
    jobs            => undef,
    lock_file       => $ENV{AGENT_TEST_LOCK} || join('/', $ENV{HOME} // '', 'projects', '.agent-test-lock'),
);

my @cmd;
{
    my @args = @ARGV;
    while (@args) {
        my $arg = shift @args;
        if ($arg eq '--') { @cmd = @args; last }

        if    ($arg eq '--jobs')                 { $opt{jobs}            = shift @args }
        elsif ($arg eq '--timeout')              { $opt{timeout}         = shift @args }
        elsif ($arg eq '--wait')                 { $opt{wait}            = shift @args }
        elsif ($arg eq '--lock-file')            { $opt{lock_file}       = shift @args }
        elsif ($arg eq '--no-lock')              { $opt{'no-lock'}       = 1 }
        elsif ($arg eq '--no-author')            { $opt{'no-author'}     = 1 }
        elsif ($arg eq '--memory-max')           { $opt{memory_max}      = shift @args }
        elsif ($arg eq '--no-memory-cap')        { $opt{'no-memory-cap'} = 1 }
        elsif ($arg eq '--quiet')                { $opt{quiet}           = 1 }
        elsif ($arg eq '--help' || $arg eq '-h') { usage(0) }
        elsif ($arg =~ /^--jobs=(.+)$/)          { $opt{jobs}       = $1 }
        elsif ($arg =~ /^--timeout=(.+)$/)       { $opt{timeout}    = $1 }
        elsif ($arg =~ /^--wait=(.+)$/)          { $opt{wait}       = $1 }
        elsif ($arg =~ /^--lock-file=(.+)$/)     { $opt{lock_file}  = $1 }
        elsif ($arg =~ /^--memory-max=(.+)$/)    { $opt{memory_max} = $1 }
        else                                     { die "Unknown option '$arg'. Put the command after '--'.\n" }
    }
}

usage(1) unless @cmd;

die "agent-test-lock: --memory-max takes a systemd size such as 75% or 48G, got '" . ($opt{memory_max} // '') . "'\n"
    unless valid_size($opt{memory_max});

my $jobs    = defined $opt{jobs}    ? $opt{jobs}    : jobs_from_command(@cmd);
my $timeout = defined $opt{timeout} ? $opt{timeout} : $jobs <= 1 ? 900 : 300;

# The wrapper's command line is the source of truth. Inherited environment
# cannot silently change which suite the caller requested.
$ENV{AUTHOR_TESTING} = $opt{'no-author'} ? 0 : 1;

my $lock_fh;
if (!$opt{'no-lock'} && $jobs > $JOB_THRESHOLD) {
    $lock_fh = acquire_lock($opt{lock_file}, $opt{wait});
    unless ($lock_fh) {
        print STDERR "agent-test-lock: gave up waiting for $opt{lock_file} after $opt{wait}s\n";
        exit($EXIT_NO_LOCK);
    }
}
elsif (!$opt{quiet}) {
    my $why = $opt{'no-lock'} ? '--no-lock' : "concurrency $jobs is at or below $JOB_THRESHOLD";
    print STDERR "agent-test-lock: running without the shared lock ($why)\n";
}

my $scope = $opt{'no-memory-cap'} ? undef : memory_scope($opt{memory_max});

exit(run_command($timeout, $scope, @cmd));

# {{{ Memory cap

# A subset of systemd's MemoryMax syntax: a percentage up to 100 with at most
# two decimals, or a byte count with an optional upper-case K/M/G/T suffix. A
# floor of 1M keeps the cap above what a shell needs to start at all.
sub valid_size {
    my ($size) = @_;
    return 0 unless defined $size;
    return $1 > 0 && $1 <= 100 if $size =~ /^(\d+(?:\.\d{1,2})?)%$/;

    my %mult = ('' => 1, K => 1024, M => 1024**2, G => 1024**3, T => 1024**4);
    return $1 * $mult{$2} >= $mult{M} if $size =~ /^(\d+(?:\.\d+)?)([KMGT]?)$/;
    return 0;
}

sub own_cgroup {
    my ($pid) = @_;
    open(my $fh, '<', "/proc/$pid/cgroup") or return undef;
    while (my $line = <$fh>) {
        return $1 if $line =~ m{^0::(/.*)$};
    }
    return undef;
}

# Returns the transient scope name to run under, or undef when the run goes
# uncapped. A throwaway probe scope proves systemd can create one and that the
# memory controller is enforced there, without risking the real command.
sub memory_scope {
    my ($size) = @_;

    # A new scope would move the command out of the enclosing one and escape
    # its cap, so a nested run stays where it is.
    my $cgroup = own_cgroup($$) // '';
    if ($cgroup =~ m{/(agent-test-lock-\d+-\d+\.scope)$}) {
        print STDERR "agent-test-lock: already inside $1, its memory cap applies\n" unless $opt{quiet};
        return undef;
    }

    my $probe_unit = "agent-test-lock-probe-$$";
    my @probe      = (
        scope_command($probe_unit, $size),
        'sh', '-c', 'test -e "/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup)/memory.max"',
    );
    my $error = capture_stderr(@probe);

    if (defined $error) {
        my $killed = report_memory_kill($probe_unit, 1);
        $error =~ s/\s+\z//;
        $error = "a $size cap is too small to start the command" if $killed;
        $error = 'the memory controller is not enabled for user scopes' unless length $error;
        print STDERR "agent-test-lock: WARNING: running without the memory cap: $error\n";
        return undef;
    }

    print STDERR "agent-test-lock: memory capped at $size (swap off)\n" unless $opt{quiet};
    return join('-', 'agent-test-lock', $$, time);
}

# Runs a command with STDERR captured. Returns undef on success, or the
# captured STDERR (possibly empty) on failure.
sub capture_stderr {
    my (@command) = @_;

    pipe(my $reader, my $writer) or die "agent-test-lock: pipe failed: $!\n";
    my $pid = fork // die "agent-test-lock: fork failed: $!\n";

    unless ($pid) {
        close($reader);
        open(STDOUT, '>',  '/dev/null') or POSIX::_exit(127);
        open(STDERR, '>&', $writer)     or POSIX::_exit(127);
        no warnings 'exec';
        exec {$command[0]} @command;
        print STDERR "cannot run $command[0]: $!\n";
        POSIX::_exit(127);
    }

    close($writer);
    my $error = do { local $/; <$reader> }
        // '';
    close($reader);
    waitpid($pid, 0);

    return $? ? $error : undef;
}

sub scope_command {
    my ($unit, $size) = @_;
    return ('systemd-run', '--user', '--scope', '--quiet', "--unit=$unit", '-p', "MemoryMax=$size", '-p', 'MemorySwapMax=0', '--');
}

# memory.peak is a high-water mark, so the last read before the scope
# disappears is the run's peak, short only of growth in the final interval.
sub read_peak {
    my ($pid, $unit, $peak) = @_;

    my $cgroup = own_cgroup($pid) // return $peak;
    return $peak unless $cgroup =~ m{/\Q$unit\E\.scope$};

    open(my $fh, '<', "/sys/fs/cgroup$cgroup/memory.peak") or return $peak;
    my $value = <$fh>;
    return $peak unless defined $value && $value =~ /^(\d+)/;
    return $1 > ($peak // 0) ? $1 : $peak;
}

sub human_size {
    my ($bytes) = @_;
    my @units   = qw/B K M G T/;
    my $i       = 0;
    while ($bytes >= 1024 && $i < $#units) { $bytes /= 1024; $i++ }
    return sprintf($i ? '%.1f%s' : '%d%s', $bytes, $units[$i]);
}

# A cgroup OOM kill looks like any other killed test from the outside. The
# scope records why it failed, so name it and clear the failed unit.
sub report_memory_kill {
    my ($unit, $silent) = @_;

    my $result = `systemctl --user show -p Result --value $unit.scope 2>/dev/null`;
    return 0 unless defined $result && $result =~ /^oom-kill/;

    system('systemctl', '--user', 'reset-failed', "$unit.scope") if $silent;
    return 1                                                     if $silent;

    print STDERR "agent-test-lock: the run hit the memory cap ($opt{memory_max}) and was killed. This is not an ordinary test failure.\n";
    system('systemctl', '--user', 'reset-failed', "$unit.scope");
    return 1;
}

# }}} Memory cap

# {{{ Lock handling

sub acquire_lock {
    my ($path, $max_wait) = @_;

    sysopen(my $fh, $path, O_RDWR | O_CREAT, 0644)
        or die "agent-test-lock: cannot open '$path': $!\n";

    my $start    = time;
    my $reported = -1;

    while (1) {
        if (flock($fh, LOCK_EX | LOCK_NB)) {
            write_holder($fh);
            print STDERR "agent-test-lock: holding $path (jobs=$jobs)\n" unless $opt{quiet};
            return $fh;
        }

        my $waited = time - $start;
        return undef if $max_wait && $waited >= $max_wait;

        if (!$opt{quiet} && ($reported < 0 || $waited - $reported >= 30)) {
            $reported = $waited;
            my $holder = read_holder($path) // 'unknown holder';
            printf STDERR "agent-test-lock: waiting on %s (%ds)\n  held by: %s\n", $path, $waited, $holder;
        }

        sleep 2;
    }
}

sub write_holder {
    my ($fh) = @_;

    my $info = sprintf(
        "pid=%d host=%s since=%s cwd=%s jobs=%s cmd=%s\n",
        $$, hostname(), strftime('%Y-%m-%d %H:%M:%S', localtime), getcwd(), $jobs, join(' ', @cmd),
    );

    $fh->autoflush(1);
    seek($fh, 0, 0);
    truncate($fh, 0);
    print {$fh} $info;
    return;
}

sub read_holder {
    my ($path) = @_;
    open(my $fh, '<', $path) or return undef;
    my $line = <$fh>;
    return undef unless defined $line;
    chomp $line;
    return length($line) ? $line : undef;
}

# }}} Lock handling

# {{{ Command execution

# Runs the command in its own process group so a timeout can take out the
# whole tree -- a stuck suite usually has children (servers, watchers,
# nested runners) that outlive the harness itself.
sub run_command {
    my ($timeout, $scope, @command) = @_;

    # systemd-run --scope execs the command in place, so it stays in the
    # process group the timeout kills.
    unshift @command => scope_command($scope, $opt{memory_max}) if $scope;

    my $pid = fork // die "agent-test-lock: fork failed: $!\n";

    unless ($pid) {
        setpgrp(0, 0);
        no warnings 'exec';
        exec {$command[0]} @command;
        print STDERR "agent-test-lock: exec '$command[0]' failed: $!\n";
        POSIX::_exit(127);
    }

    my $timed_out = 0;
    local $SIG{ALRM} = sub {
        $timed_out = 1;
        print STDERR "agent-test-lock: timeout after ${timeout}s, killing process group $pid\n";
        kill('TERM', -$pid);
        sleep 5;
        kill('KILL', -$pid);
    };

    for my $sig (qw/INT TERM HUP/) {
        $SIG{$sig} = sub { kill($sig, -$pid) };
    }

    alarm($timeout) if $timeout;
    my $peak;
    if ($scope) {
        while (1) {
            my $done = waitpid($pid, WNOHANG);
            last if $done == $pid || $done < 0;
            $peak = read_peak($pid, $scope, $peak);
            Time::HiRes::sleep(0.25);
        }
    }
    else {
        waitpid($pid, 0);
    }
    my $status = $?;
    alarm(0) if $timeout;

    if ($scope) {
        report_memory_kill($scope)                                                                     if $status;
        print STDERR "agent-test-lock: memory peak " . human_size($peak) . " (cap $opt{memory_max})\n" if defined $peak;
    }

    return $EXIT_TIMEOUT if $timed_out;
    return $status >> 8  if ($status & 127) == 0;
    return 128 + ($status & 127);
}

# }}} Command execution

# {{{ Argument inspection

# Pull the concurrency out of a prove/yath/make command line so callers do
# not have to repeat it. Anything unrecognised is treated as high-concurrency
# (safer to over-lock than to swamp the box).
sub jobs_from_command {
    my @command = @_;

    for (my $i = 0; $i < @command; $i++) {
        my $arg = $command[$i];

        return $1 if $arg =~ /^-j(\d+)$/;
        return $1 if $arg =~ /^--jobs=(\d+)$/;
        return $1 if $arg =~ /^-j=(\d+)$/;

        if ($arg eq '-j' || $arg eq '--jobs') {
            my $next = $command[$i + 1];
            return $next if defined $next && $next =~ /^\d+$/;
        }
    }

    return 16;
}

# }}} Argument inspection

sub usage {
    my ($code) = @_;

    print STDERR <<"EOT";
Usage: agent-test-lock [options] -- <command...>

  --jobs N        Concurrency this run will use (default: parsed from the
                  command, else 16). At or below $JOB_THRESHOLD the lock is skipped.
  --timeout SECS  Kill the command after this long (default 900 for serial,
                  300 for concurrent; 0 disables).
  --wait SECS     Give up waiting for the lock after this long (default 3600).
  --no-lock       Run without taking the lock.
  --no-author     Force AUTHOR_TESTING=0.
  --lock-file P   Override the lock path.
  --memory-max S  Memory cap for the run, as a systemd MemoryMax value
                  (default 75% of RAM; e.g. 48G). Swap is off inside the cap.
  --no-memory-cap Run without the memory cap.
  --quiet         Do not narrate lock acquisition.

AUTHOR_TESTING=1 is forced unless --no-author is given. --no-author forces
AUTHOR_TESTING=0.

The memory cap needs a user systemd session. Without one the run goes ahead
uncapped with a warning.

Example:
  agent-test-lock -- prove --timer -Ilib -j16 -r t/
EOT

    exit($code);
}

#!/usr/bin/env bash
set -euo pipefail

# OPTIONAL convenience. Nothing in this repository requires installation --
# AGENTS.md points agents at every tool and procedure by absolute path, and
# they work from any project as-is.
#
# What this adds: Claude Code and Codex only auto-discover skills under
# ~/.claude/skills and ~/.codex/skills. Linking them there gains `/name`
# invocation and automatic surfacing. Linking bin/ into ~/.local/bin saves
# typing the absolute path.
#
#   ~/.claude/skills   ->  skills/          (whole directory, when free)
#   ~/.codex/skills/<name> -> skills/<name> (per skill -- .system lives there)
#   ~/.local/bin/<tool>    -> bin/<tool>
#
# Linking the whole directory is preferred: a skill added later appears
# without re-running this. It is only done when nothing is already there.
#
# Idempotent. Only ever replaces symlinks it would have created itself; a real
# file or directory in the way is reported and left alone.
#
# Usage:
#   ./install            # link everything
#   ./install --dry-run  # show what it would do

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

link() {
    local src="$1" dest="$2"

    if [[ -L "$dest" ]]; then
        local current
        current="$(readlink "$dest")"
        if [[ "$current" == "$src" ]]; then
            echo "  ok       $dest"
            return
        fi
        if ! is_agents_link "$current"; then
            echo "  SKIP     $dest is a user-owned symlink to $current -- left alone"
            return
        fi
        echo "  relink   $dest (was $current)"
        [[ $DRY_RUN -eq 1 ]] && return
        rm "$dest"
    elif [[ -e "$dest" ]]; then
        echo "  SKIP     $dest exists and is not a symlink -- left alone"
        return
    else
        echo "  link     $dest"
    fi

    [[ $DRY_RUN -eq 1 ]] && return
    ln -s "$src" "$dest"
}

is_agents_link() {
    local target="$1"

    [[ "$target" == "$ROOT"/* ]] && return 0
    [[ "$target" == */Agents/skills ]] && return 0
    [[ "$target" == */Agents/skills/* ]] && return 0
    [[ "$target" == */Agents/bin/* ]] && return 0
    return 1
}

link_each_skill() {
    local target_root="$1"

    [[ $DRY_RUN -eq 1 ]] || mkdir -p "$target_root"

    local skill
    for skill in "$ROOT"/skills/*/; do
        [[ -f "$skill/SKILL.md" ]] || continue
        link "${skill%/}" "$target_root/$(basename "$skill")"
    done
}

# Claude Code: ~/.claude/skills is ours alone, so link the whole directory when
# it is free. Anything already there means the user keeps their own skills in
# it -- fall back to linking each one.
install_claude_skills() {
    local target="$HOME/.claude/skills"

    [[ $DRY_RUN -eq 1 ]] || mkdir -p "$HOME/.claude"
    echo "$target:"

    if [[ ! -e "$target" && ! -L "$target" ]]; then
        link "$ROOT/skills" "$target"
        echo "           (whole directory -- new skills appear with no re-run)"
        return
    fi

    if [[ -L "$target" ]]; then
        local current
        current="$(readlink "$target")"
        if [[ "$current" == "$ROOT/skills" ]] || is_agents_link "$current"; then
            link "$ROOT/skills" "$target"
        elif [[ -d "$target" ]]; then
            echo "           (user-owned directory symlink -- linking skills individually)"
            link_each_skill "$target"
        else
            echo "  SKIP     $target is a user-owned dangling symlink -- left alone"
        fi
        return
    fi

    echo "           (directory already exists -- linking skills individually)"
    link_each_skill "$target"
}

# Codex ships its own skills under ~/.codex/skills/.system, so the directory is
# shared and must never be replaced wholesale.
install_codex_skills() {
    local target="$HOME/.codex/skills"

    [[ -d "$HOME/.codex" ]] || { echo "$target: (skipping -- ~/.codex missing)"; return; }

    echo "$target:"
    link_each_skill "$target"
}

install_bin() {
    local target_root="$HOME/.local/bin"

    [[ $DRY_RUN -eq 1 ]] || mkdir -p "$target_root"

    echo "$target_root:"
    local tool
    for tool in "$ROOT"/bin/*; do
        [[ -f "$tool" && -x "$tool" ]] || continue
        link "$tool" "$target_root/$(basename "$tool")"
    done
}

[[ $DRY_RUN -eq 1 ]] && echo "DRY RUN -- nothing will be changed"

install_claude_skills
install_codex_skills
install_bin

echo
echo "Done. None of this is required: AGENTS.md points at every tool and"
echo "procedure by absolute path, e.g. ~/projects/Agents/bin/agent-test-lock"
